# Public browser/server values from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secret key. Never prefix this value with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional dedicated HMAC secret for replay-safe staff invitation tokens.
# If omitted, the server-only Supabase secret key is used.
STAFF_INVITATION_TOKEN_SECRET=replace_with_a_long_random_invitation_secret

# Optional dedicated HMAC secret for replay-safe resident/owner invitation tokens.
# If omitted, the server-only Supabase secret key is used.
RELATIONSHIP_INVITATION_TOKEN_SECRET=replace_with_a_long_random_invitation_secret

# Server-only Stripe Connect platform key. Start with an sk_test_ key outside production.
STRIPE_SECRET_KEY=sk_test_replace_me

# Server-only signing secret for the Stripe Connect webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Server-only bearer secret for scheduled/internal workers. Use at least 32 random characters.
CRECY_INTERNAL_WORKER_SECRET=replace_with_a_long_random_worker_secret

# Public canonical origin used for auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional outbound relay for transactional notifications. The worker POSTs rendered messages
# here; point it at your own sending service. Without it the notification worker reports 503.
CRECY_NOTIFICATION_RELAY_URL=https://replace_me.example.com/notifications
CRECY_NOTIFICATION_RELAY_SECRET=replace_with_a_long_random_relay_secret
