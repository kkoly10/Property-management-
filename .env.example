# Public browser/server values from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only credential that bypasses RLS. Never prefix it with NEXT_PUBLIC_ or expose it to browser
# code. Two names are accepted, and the FIRST USABLE one wins — a value containing "replace_me" counts
# as unset, so a half-filled variable cannot shadow a real one in the next:
#
#   1. SUPABASE_SECRET_KEY        the modern sb_secret_… key (Settings -> API Keys -> Secret key)
#   2. SUPABASE_SERVICE_ROLE_KEY  the legacy JWT, provisioned automatically by the Supabase↔Vercel
#                                 integration. A Vercel deployment linked to Supabase already has it.
#
# Set either. On Vercel you may already have the second for free. Legacy JWT keys are on Supabase's
# deprecation path, so prefer the first for anything long-lived.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional dedicated HMAC secret for replay-safe staff invitation tokens.
# If omitted, the server-only Supabase secret key is used.
STAFF_INVITATION_TOKEN_SECRET=replace_with_a_long_random_invitation_secret

# Optional dedicated HMAC secret for replay-safe resident/owner invitation tokens.
# If omitted, the server-only Supabase secret key is used.
RELATIONSHIP_INVITATION_TOKEN_SECRET=replace_with_a_long_random_invitation_secret

# Server-only Stripe Connect platform key. Start with an sk_test_ key outside production.
STRIPE_SECRET_KEY=sk_test_replace_me

# Server-only signing secret for the Stripe Connect webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Server-only bearer secret for scheduled/internal workers. Use at least 32 random characters.
CRECY_INTERNAL_WORKER_SECRET=replace_with_a_long_random_worker_secret

# Canonical origin of the OPERATOR APPLICATION (Crecy OS) — production https://app.crecyos.com.
# This is the origin that auth callbacks, signup confirmation, secure document links, transactional
# mail links and Stripe Connect return/refresh URLs are built from. It is NOT the marketing origin;
# the two hosts are distinct and neither is derived from the other.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public canonical origin for the MARKETING site (Crecy) — production https://crecyos.com. Every public
# page's canonical URL, Open Graph url, sitemap entry and robots host is built from this — it is
# deliberately NOT inferred from the request host, or a preview deployment would publish canonicals
# pointing at itself.
#
# SET THIS ON THE FIRST DEPLOY. It defaults to https://crecyos.com, so a build served from a
# *.vercel.app domain would otherwise advertise canonicals for a domain that does not serve it.
# A value that is not a valid absolute http(s) URL throws at module load rather than failing quietly.
NEXT_PUBLIC_MARKETING_ORIGIN=https://crecyos.com

# Root domain of the Crecy Living resident brand. Community portals are served at
# {community-slug}.crecyliving.com. Resident-facing absolute links are built from this root rather
# than from the operator or marketing origin, so residents are never sent into Crecy OS.
# Wildcard DNS/TLS for *.crecyliving.com is a separate deployment gate — see the launch runbook.
NEXT_PUBLIC_LIVING_ROOT_DOMAIN=crecyliving.com

# Canonical origin of the Crecy Owner portal. Owner-facing absolute links (invitation activation) are
# built from this. Defaults to owner.<marketing apex>, so it only needs setting if that is not right.
NEXT_PUBLIC_OWNER_ORIGIN=https://owner.crecyos.com

# Outbound relay for transactional notifications. The worker POSTs rendered messages here and reads
# back a provider message id; without it the notification worker reports 503 and no mail is sent.
#
# This repository ships a Resend adapter at /api/internal/notifications/relay, so in production point
# the URL at your own deployment and set RESEND_API_KEY below. The worker still only knows the relay
# contract, so the vendor stays swappable.
CRECY_NOTIFICATION_RELAY_URL=https://app.crecyos.com/api/internal/notifications/relay
CRECY_NOTIFICATION_RELAY_SECRET=replace_with_a_long_random_relay_secret

# Resend API key, used ONLY by the bundled relay adapter. Resend dashboard → API Keys → `re_…`.
# Sending permission is all it needs; do not use a full-access key.
RESEND_API_KEY=re_replace_me

# Optional From overrides. The defaults are derived so the From domain always matches the domain of the
# links in the body — resident mail from the Crecy Living domain, operator and owner mail from the
# Crecy domain — because a From/link mismatch reads as phishing to filters and to recipients.
#   operator -> Crecy <notifications@notifications.crecyos.com>
#   resident -> Crecy Living <notifications@notifications.crecyliving.com>
#   owner    -> Crecy Owner <notifications@notifications.crecyos.com>
# CRECY_MAIL_FROM_OPERATOR=
# CRECY_MAIL_FROM_RESIDENT=
# CRECY_MAIL_FROM_OWNER=
# CRECY_MAIL_REPLY_TO_OPERATOR=
# CRECY_MAIL_REPLY_TO_RESIDENT=
# CRECY_MAIL_REPLY_TO_OWNER=

# Optional outbound relay for document malware scanning. The worker POSTs the stored bytes here and
# reads back {"verdict":"clean"|"infected","reference":"..."}. Without it the scan worker reports 503
# and uploaded documents stay quarantined — the safe direction to fail.
CRECY_DOCUMENT_SCAN_RELAY_URL=https://replace_me.example.com/scan
CRECY_DOCUMENT_SCAN_RELAY_SECRET=replace_with_a_long_random_scan_relay_secret

# Set by the operator on Vercel so scheduled cron invocations authenticate. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Without it every /api/internal/cron/* route stays closed.
CRON_SECRET=replace_with_a_long_random_cron_secret

# The deployment environment, used to decide where legal documents must be PUBLISHED before consent can
# be recorded. Vercel sets VERCEL_ENV automatically, so most deployments need nothing here.
#
# LEAVE THIS UNSET unless you are self-hosting a NON-production environment. Anything other than
# "production" RELAXES the gate, and an unlabeled build is treated as production and fails closed —
# which is the safe direction. Copying a `CRECY_DEPLOYMENT_ENV=development` line into a real deployment
# would let it record consent against unpublished draft documents, so no value ships here.
# CRECY_DEPLOYMENT_ENV=development
