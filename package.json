    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "radix-ui": "1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.82.0",
    "sonner": "2.0.7",
    "stripe": "22.3.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "^1.62.1",
