{
  "name": "crecy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/validate-schema.mjs",
    "test:e2e": "playwright test",
    "test:e2e:connected": "playwright test --config=playwright.connected.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db && npm run build"
  },
