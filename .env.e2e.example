# Connected-mode E2E configuration (copy to .env.e2e.local and fill in; .env.e2e.local is gitignored).
# These point the connected Playwright suite (playwright.connected.config.ts) at a live Supabase
# project and a confirmed test auth user. Public values only — never put the SECRET key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Operator (org owner) — onboarding, lease activation, manual payment legs.
E2E_EMAIL=crecy-e2e@example.test
E2E_PASSWORD=replace_with_the_seeded_user_password
# Resident portal user — the Crecy Living leg (payment-and-portal.spec.ts). Optional; that
# leg self-skips if unset. Needs an active resident_person user_relationship seeded to a tenancy.
E2E_RESIDENT_EMAIL=crecy-e2e-resident@example.test
E2E_RESIDENT_PASSWORD=replace_with_the_seeded_resident_password
