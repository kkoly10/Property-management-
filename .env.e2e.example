# Connected-mode E2E configuration (copy to .env.e2e.local and fill in; .env.e2e.local is gitignored).
# These point the connected Playwright suite (playwright.connected.config.ts) at a live Supabase
# project and a confirmed test auth user. Public values only — never put the SECRET key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Operator (org owner) — onboarding, lease activation, manual payment legs.
E2E_EMAIL=crecy-e2e@example.test
E2E_PASSWORD=replace_with_the_seeded_user_password
# Resident portal user — the Crecy Living legs (payment-and-portal, document-delivery). Optional;
# those legs self-skip if unset. Needs an active resident_person user_relationship seeded to a tenancy.
E2E_RESIDENT_EMAIL=crecy-e2e-resident@example.test
E2E_RESIDENT_PASSWORD=replace_with_the_seeded_resident_password
# Owner portal user — the owner-statement leg. Optional; self-skips if unset. Needs an active
# owner_entity user_relationship.
E2E_OWNER_EMAIL=crecy-e2e-owner@example.test
E2E_OWNER_PASSWORD=replace_with_the_seeded_owner_password

# Fixture ids for the extended legs (document-delivery, financial-reversals, owner-statement).
# These come from the out-of-band seed for a given run — see CONNECTED_E2E_VERIFICATION_REPORT.md.
E2E_ORG_ID=00000000-0000-0000-0000-000000000000
E2E_PROPERTY_ID=00000000-0000-0000-0000-000000000000
E2E_DELIVER_VERSION_ID=00000000-0000-0000-0000-000000000000
E2E_RESIDENT_PERSON_ID=00000000-0000-0000-0000-000000000000
E2E_PAYMENT_ID=00000000-0000-0000-0000-000000000000
E2E_OWNER_ENTITY_ID=00000000-0000-0000-0000-000000000000
